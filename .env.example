# Copiá este archivo como .env.local y completá los valores de tu proyecto de Supabase
# (Supabase > Project Settings > API). Nunca subas .env.local al repositorio.
#
# Estos dos valores son públicos por diseño: la seguridad de los datos la dan
# el inicio de sesión y las reglas de seguridad por filas (RLS) de la base.
# NUNCA uses aquí la clave "service_role" / "secret".
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
